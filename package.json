    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
